APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

STOREFRONT_WEB_URL=https://stjecommerce.stjacks.com/{country}
STOREFRONT_PASSWORD_RESET_URL=https://stjecommerce.stjacks.com/{country}/cuenta/restablecer/{token}
STOREFRONT_PASSWORD_RESET_TTL_MINUTES=30
STOREFRONT_CONTACT_TO=servicioalcliente@stjacks.com
APP_TIMEZONE=America/El_Salvador

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

PROMOTIONS_LIFECYCLE_AUTHORITY=legacy
# CACHE_PREFIX= yxy

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send
SMTP2GO_API_KEY=
SMTP2GO_SENDER="\"St. Jack's\" Online <no-reply@stjacks.online>"
SMTP2GO_TIMEOUT=15
PROMOTIONS_NOTIFICATION_EMAILS=

# Confirmaciones de compra siempre se envían por SMTP2GO. Las integraciones
# externas permanecen apagadas en test/staging y se habilitan solo en producción.
STOREFRONT_POST_PURCHASE_INTEGRATIONS_ENABLED=false
STOREFRONT_POST_PURCHASE_CONNECT_TIMEOUT=2
STOREFRONT_POST_PURCHASE_TIMEOUT=5
STOREFRONT_GT_ORDER_INTEGRATION_ENABLED=true
STOREFRONT_CR_ORDER_INTEGRATION_ENABLED=true
STOREFRONT_PA_ORDER_INTEGRATION_ENABLED=true
STOREFRONT_POS_RESERVATION_URL=http://service.pos.stjacks.com:443/api/v1/productotienda-service/producto-tienda-reserva/reserva/{store}/{sku}-{size}/{reference}/{quantity}/{country}
STOREFRONT_HN_PRISM_ENABLED=true
STOREFRONT_HN_PRISM_URL=https://stjacks.com/Honduras/Prism/prism_crear_documento_items_y_tender

# Comma-separated countries allowed to override the general shipping rate
# with stj_world_cities.costo. Honduras is the only active country today.
STOREFRONT_SHIPPING_CITY_RATE_COUNTRIES=HN

FCM_API_URL=https://fcm.googleapis.com/v1
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_TOKEN_URL=https://oauth2.googleapis.com/token
FCM_TIMEOUT=30
FCM_SEND_TIMEOUT=8
FCM_CONNECT_TIMEOUT=3
FCM_TOKEN_CHUNK_SIZE=50
FCM_IMAGE_BASE_URL=https://stjacks.com
FCM_ICON_URL=https://stj-assets.sfo3.cdn.digitaloceanspaces.com/logos/notificaciones_push/logostj.png
FCM_WEB_HOME_URL=https://stjacks.com

PUSH_WEB_AUTOMATION_ENABLED=false
PUSH_WEB_EVALUATE_LIMIT=500
PUSH_WEB_SEND_LIMIT=100
PUSH_WEB_MAX_ATTEMPTS=3
PUSH_WEB_BASE_RETRY_MINUTES=5
PUSH_WEB_PROCESSING_TIMEOUT_MINUTES=15
PUSH_WEB_PUBLIC_BASE_URL=https://api.stjacks.com
PUSH_WEB_CLICK_URL_TTL_DAYS=30

INVENTORY_API_TOKEN=
INVENTORY_SYNC_SV_CATEGORIES_URL=
INVENTORY_SYNC_GT_CATEGORIES_URL=
INVENTORY_SYNC_CR_CATEGORIES_URL=
INVENTORY_SYNC_NI_CATEGORIES_URL=
INVENTORY_SYNC_PA_CATEGORIES_URL=
INVENTORY_SYNC_DO_CATEGORIES_URL=
INVENTORY_SYNC_HN_CATEGORIES_URL=
INVENTORY_SYNC_VE_CATEGORIES_URL=
INVENTORY_SYNC_GENERIC_CATEGORIES_URL=
INVENTORY_SYNC_TIMEOUT_SECONDS=20
INVENTORY_SYNC_CONNECT_TIMEOUT_SECONDS=5
INVENTORY_SYNC_RETRY_TIMES=2
INVENTORY_SYNC_RETRY_DELAY_MS=500

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=stj-assets
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_URL=https://stj-assets.sfo3.cdn.digitaloceanspaces.com

VITE_APP_NAME="${APP_NAME}"

# Comma-separated browser origins allowed to call stj-api with credentials.
CORS_ALLOWED_ORIGINS=http://localhost
# Comma-separated native Capacitor origins allowed to call mobile endpoints.
CORS_MOBILE_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,http://localhost:8100,https://localhost
MOBILE_LEGACY_CATEGORY_ASSET_URL=https://stjacks.com/api-resources/categorias
MOBILE_LEGACY_PRODUCT_IMAGE_URL=https://stj-assets.sfo3.cdn.digitaloceanspaces.com/images/p400
# Local HTTP uses false. Production HTTPS must use true.
STOREFRONT_VISITOR_COOKIE=stj_visitor
STOREFRONT_VISITOR_TTL_DAYS=365
STOREFRONT_VISITOR_SECURE=false
# Empty keeps the cookie host-only.
STOREFRONT_VISITOR_DOMAIN=
POWERTRANZ_ENVIRONMENT=staging
POWERTRANZ_URL=https://staging.ptranz.com/api/spi/sale
POWERTRANZ_PAYMENT_URL=https://staging.ptranz.com/api/spi/payment
POWERTRANZ_CONNECT_TIMEOUT=5
POWERTRANZ_TIMEOUT=20
POWERTRANZ_RETURN_BASE_URL=http://localhost/stj-api/public/api/storefront/payments/powertranz/return
POWERTRANZ_FRONTEND_RESULT_URL=http://localhost/stj-ecommerce/public/{country}/pago/resultado/{hint}
POWERTRANZ_RETURN_TOKEN_TTL_MINUTES=60
POWERTRANZ_SV_ID=
POWERTRANZ_SV_PASSWORD=
POWERTRANZ_SV_CURRENCY_CODE=840
POWERTRANZ_GT_ID=
POWERTRANZ_GT_PASSWORD=
POWERTRANZ_GT_CURRENCY_CODE=320
POWERTRANZ_CR_ID=
POWERTRANZ_CR_PASSWORD=
POWERTRANZ_CR_CURRENCY_CODE=188
POWERTRANZ_PA_ID=
POWERTRANZ_PA_PASSWORD=
POWERTRANZ_PA_CURRENCY_CODE=840
POWERTRANZ_HN_ID=
POWERTRANZ_HN_PASSWORD=
POWERTRANZ_HN_CURRENCY_CODE=340
